# Browser API origin. Empty in development uses the Vite /api proxy; production uses the Timeweb backend origin.
VITE_KUBIKI_API_BASE_URL=

# Standalone backend.
DATABASE_URL=postgresql://kubiki_app:replace-me@127.0.0.1:5432/kubiki
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Yandex SMTP credentials. All SMTP variables are backend-only.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailer@example.invalid
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_FROM=Kubiki <mailer@example.invalid>
PORT=3000
HOST=127.0.0.1
# BACKEND_BODY_LIMIT_BYTES=1048576
# READINESS_TIMEOUT_MILLIS=2000

# Server-side OpenAI-compatible AI provider. Existing production may keep only DEEPSEEK_API_KEY.
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com/chat/completions
# AI_MODEL=deepseek-v4-flash
# AI_API_KEY=replace-me
# DEEPSEEK_API_KEY=replace-me

# Private S3-compatible export-logo bucket. Credentials are backend-only.
S3_ENDPOINT=https://s3.example.invalid
S3_REGION=replace-with-region
S3_BUCKET=kubiki-private
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# S3_FORCE_PATH_STYLE=false
# S3_SIGNED_URL_TTL_SECONDS=300
